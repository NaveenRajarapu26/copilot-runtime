# Existing runtime settings
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# Optional: server-owned FlowOne Core API URL. During localhost migration the
# runtime can still use the current core-ui environment header when omitted.
FLOWONE_CORE_API_URL=

# Feature 5 durable state. Defaults to ./.flowone/agent_state.db
FLOWONE_STATE_DB_PATH=.flowone/agent_state.db
